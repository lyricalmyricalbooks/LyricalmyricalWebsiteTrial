rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "lyricalmyricalbooks@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shipping-profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Integration credentials are only available to Cloud Functions through
    // the Admin SDK. Even authenticated admins cannot read the raw keys in a browser.
    match /private-integrations/{integrationId} {
      allow read, write: if false;
    }
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Publisher packing, holds and internal notes never appear in guest tracking.
    // Written only by Cloud Functions (sendEmail); the admin reads it in Notifications.
    // Private email-sending credentials (Gmail app password). Admin-only: unlike settings/*,
    // this is never publicly readable. Cloud Functions read it with the Admin SDK.
    match /adminSecrets/{docId} {
      allow read, write: if isAdmin();
    }
    match /emailLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /order-operations/{orderId} {
      allow read, write: if isAdmin();
    }
    match /orders/{orderId} {
      // Guests never read orders directly: order tracking and the checkout
      // thank-you page ask the server (createStripeCheckoutSession action
      // "track"), which checks the customer email or emailed link key.
      // Admins see everything; signed-in customers only their own orders.
      allow get, list: if isAdmin()
        // Only a verified sign-in email may list a customer's orders.
        || (request.auth != null && request.auth.token.email_verified == true
          && resource.data.customer.email == request.auth.token.email);
      // Orders are always created unpaid; only verified payment handlers using
      // the Admin SDK flip them to paid. Admins may create orders in any state
      // (for example, manual/sample orders).
      allow create: if isAdmin()
        // Guests only start card/PayPal orders here. Manual-payment orders are priced and
        // created by Functions (createManualLocalOrder), never by the browser.
        || (request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.status == "pending_payment"
        && request.resource.data.orderId == orderId
        && request.resource.data.trackingKey is string
        && request.resource.data.trackingKey.matches('^[a-f0-9]{64}$')
        // Only checkout's own fields: no isTest, inventory/discount/refund markers or payment ids.
        && request.resource.data.keys().hasOnly(['customer', 'cartId', 'customerId', 'referralSource', 'orderNote',
          'addressVerified', 'addressError', 'items', 'subtotal', 'discount', 'shipping', 'shippingMethod',
          'fulfillmentSelection', 'tax', 'total', 'status', 'paymentStatus', 'paymentMethod', 'paymentInstructions',
          'testMode', 'appliedDiscount', 'metadata', 'trackingKey', 'orderId', 'createdAt', 'updatedAt', 'activity', 'giftCards'])
        // Gift card codes the shopper typed; the server prices and holds them (functions/giftCards.js).
        && (!('giftCards' in request.resource.data) || (request.resource.data.giftCards is list && request.resource.data.giftCards.size() <= 5))
        && (request.resource.data.paymentMethod == "Stripe" || request.resource.data.paymentMethod == "PayPal" || request.resource.data.paymentMethod == "Free")
        && (!('paymentInstructions' in request.resource.data) || request.resource.data.paymentInstructions == "")
        && request.resource.data.customer.email is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        // The guest submits only a method/option ID. Functions build the
        // priced fulfillment snapshot from current server configuration.
        && (!('orderNote' in request.resource.data) || (request.resource.data.orderNote is string && request.resource.data.orderNote.size() <= 500)));
      allow update, delete: if isAdmin();
    }
    // Server-only counters for the public-endpoint rate limits (functions/rateLimit.js).
    match /rate-limits/{id} {
      allow read, write: if false;
    }
    // Server-only checkout stock holds (functions/stockHolds.js).
    match /stock-holds/{bookId} {
      allow read, write: if false;
    }
    // Customer privacy requests (copy / delete my data). Created by Functions only.
    match /privacyRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
    match /theme-versions/{versionId} {
      allow read, write: if isAdmin();
    }
    // Studio's private working copy (themes/workspace: unpublished draft + save revision)
    // and My themes. Never public: shoppers only ever read the published settings/website.design.
    match /themes/{themeId} {
      allow read, write: if isAdmin();
    }
    match /savedThemes/{themeId} {
      allow read, write: if isAdmin();
    }
    match /audit-log/{logId} {
      allow read, write: if isAdmin();
    }
    match /analytics/{docId} {
      // Visitors may bump traffic/funnel counters, but order and revenue
      // figures are written exclusively by the payment webhook (Admin SDK).
      // Only the admin reads the daily docs (revenue, search terms): the storefront
      // writes counters with increment() and never needs to read them back.
      allow read: if isAdmin();
      // Each recorded map stays small, so a forged client can't bloat the doc, and
      // one write can't raise the visit counter by more than one.
      function analyticsMapsOk() {
        let d = request.resource.data;
        return (!('funnel' in d) || (d.funnel is map && d.funnel.size() <= 4))
          && (!('sources' in d) || (d.sources is map && d.sources.size() <= 60))
          && (!('devices' in d) || (d.devices is map && d.devices.size() <= 4))
          && (!('searches' in d) || (d.searches is map && d.searches.size() <= 150))
          && (!('noResults' in d) || (d.noResults is map && d.noResults.size() <= 150))
          && (!('bookViews' in d) || (d.bookViews is map && d.bookViews.size() <= 300))
          && (!('categoryViews' in d) || (d.categoryViews is map && d.categoryViews.size() <= 100));
      }
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['date', 'visits', 'orders', 'revenue', 'conversion', 'funnel', 'categoryViews', 'sources', 'devices', 'searches', 'noResults', 'bookViews'])
        && (!('orders' in request.resource.data) || request.resource.data.orders == 0)
        && (!('revenue' in request.resource.data) || request.resource.data.revenue == 0)
        && request.resource.data.get('visits', 0) <= 1
        && analyticsMapsOk()
      );
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['date', 'visits', 'funnel', 'categoryViews', 'sources', 'devices', 'searches', 'noResults', 'bookViews'])
        // Visits only ever go up by one: a visitor can't reset or shrink the day's count.
        && request.resource.data.get('visits', 0) - resource.data.get('visits', 0) <= 1
        && request.resource.data.get('visits', 0) >= resource.data.get('visits', 0)
        && analyticsMapsOk()
      );
      allow delete: if isAdmin();
    }
    // Gift cards (functions/giftCards.js): the admin reads them; only Functions create, spend or change them.
    match /giftCards/{cardId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /discounts/{docId} {
      // Public code validation happens via the validateDiscountCode function.
      allow read, write: if isAdmin();
    }
    match /customers/{customerId} {
      // Customers can read/write their own profile; admin can read all
      allow read: if request.auth != null
        && (request.auth.uid == customerId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == customerId;
      allow delete: if isAdmin();
    }
    match /newsletter/{docId} {
      // One signup per address: the document id is the lowercased email, so a repeat
      // signup is an update (refused) instead of another row. Only these three fields.
      allow create: if request.resource.data.keys().hasOnly(["email", "subscribedAt", "source"])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches("[^@/ ]+@[^@/ ]+\\.[^@/ ]+")
        && docId == request.resource.data.email
        && request.resource.data.subscribedAt is string
        && request.resource.data.subscribedAt.size() <= 40
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 60));
      allow read, update, delete: if isAdmin();
    }
    match /contactMessages/{messageId} {
      // Storefront contact form: anyone can send; only admin (and Functions) can read/change.
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "phone", "subject", "message", "page", "status", "createdAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches(".+@.+\\..+")
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["new", "emailed", "read", "archived"];
    }
    match /stockAlerts/{alertId} {
      // Shoppers can sign up for a back-in-stock email; only admin (and Functions) can read/change.
      // One alert per address + book + edition: the id is "<email>__<bookId>__<variantId>",
      // so repeats are refused instead of queueing hundreds of emails to one inbox.
      allow create: if request.resource.data.keys().hasOnly(["email", "bookId", "bookTitle", "variantId", "variantName", "status", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches("[^@/ ]+@[^@/ ]+\\.[^@/ ]+")
        && request.resource.data.bookId is string
        && request.resource.data.bookId.size() <= 160
        && request.resource.data.get("variantId", "") is string
        && alertId == request.resource.data.email + "__" + request.resource.data.bookId + "__" + request.resource.data.get("variantId", "")
        && request.resource.data.get("bookTitle", "") is string
        && request.resource.data.get("bookTitle", "").size() <= 300
        && request.resource.data.get("variantName", "") is string
        && request.resource.data.get("variantName", "").size() <= 120
        && request.resource.data.status == "waiting";
      allow read, update, delete: if isAdmin();
    }
    match /reviewContacts/{reviewId} {
      // The reviewer's email for a review, readable by the admin only.
      allow create: if request.resource.data.keys().hasOnly(["email", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      // The public sees approved reviews only; pending/rejected ones are the admin's.
      // Reviewer emails live in admin-only reviewContacts, never on the public review.
      allow read: if isAdmin() || resource.data.status == "approved";
      // Anyone can submit a review (lands "pending"); no reply, no email, no extra fields.
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(["bookId", "authorName", "rating", "title", "body", "status", "createdAt"])
        && request.resource.data.get("authorName", "") is string
        && request.resource.data.get("authorName", "").size() <= 80
        && request.resource.data.get("title", "") is string
        && request.resource.data.get("title", "").size() <= 200
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;
      allow update, delete: if isAdmin();
    }
    match /abandoned-carts/{cartId} {
      // Anyone can retrieve their own cart by its secure token; only admin can query/list all carts
      allow get: if true;
      // Browsers may only write the cart fields the storefront sends. Server-owned
      // fields (notified, notifiedAt) are off limits, and a recovered cart can't be
      // reopened, so a forged doc can't re-trigger the reminder email.
      allow create: if cartFieldsValid()
        && request.resource.data.keys().hasOnly(cartClientKeys())
        && request.resource.data.get("recovered", false) == false;
      allow update: if cartFieldsValid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(cartClientKeys())
        && (resource.data.get("recovered", false) == false || request.resource.data.get("recovered", false) == true);
      allow list, delete: if isAdmin();
    }
    function cartClientKeys() {
      return ["email", "items", "subtotal", "customer", "cartKey", "recovered", "recoveredAt", "updatedAt", "createdAt"];
    }
    function cartFieldsValid() {
      return request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && (!("items" in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 50));
    }
  }
}
