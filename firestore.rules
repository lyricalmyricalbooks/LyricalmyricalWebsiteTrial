rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "lyricalmyricalbooks@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shipping-profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Integration credentials are only available to Cloud Functions through
    // the Admin SDK. Even authenticated admins cannot read the raw keys in a browser.
    match /private-integrations/{integrationId} {
      allow read, write: if false;
    }
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      // Guest tracking is served by lookupGuestOrder, which returns a
      // deliberately restricted DTO. Browser SDK reads require an owner.
      allow get: if isAdmin()
        || (request.auth != null
        && resource.data.customer.email == request.auth.token.email);
      allow list: if isAdmin()
        || (request.auth != null && resource.data.customer.email == request.auth.token.email);
      // Orders are always created unpaid; only the Stripe webhook (Admin SDK)
      // flips them to paid. Admins may create orders in any state (e.g.
      // manual/sample orders).
      allow create: if isAdmin()
        || (request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.status == "pending_payment"
        && request.resource.data.customer.email is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50);
      allow update, delete: if isAdmin();
    }
    match /audit-log/{logId} {
      allow read, write: if isAdmin();
    }
    match /analytics/{docId} {
      // Visitors may bump traffic/funnel counters, but order and revenue
      // figures are written exclusively by the payment webhook (Admin SDK).
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['date', 'visits', 'orders', 'revenue', 'conversion', 'funnel', 'categoryViews'])
        && (!('orders' in request.resource.data) || request.resource.data.orders == 0)
        && (!('revenue' in request.resource.data) || request.resource.data.revenue == 0)
      );
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['date', 'visits', 'funnel', 'categoryViews']);
      allow delete: if isAdmin();
    }
    match /discounts/{docId} {
      // Public code validation happens via the validateDiscountCode function.
      allow read, write: if isAdmin();
    }
    match /customers/{customerId} {
      // Customers can read/write their own profile; admin can read all
      allow read: if request.auth != null
        && (request.auth.uid == customerId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == customerId;
      allow delete: if isAdmin();
    }
    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      // Public can read approved reviews (we filter client-side too)
      allow read: if true;
      // Anyone can submit a review (will land in "pending"); only admin can mutate after
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;
      allow update, delete: if isAdmin();
    }
    match /abandoned-carts/{cartId} {
      // Anyone can write their own pending cart; only admin reads
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow read, delete: if isAdmin();
    }
  }
}
