
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "lyricalmyricalbooks@gmail.com";
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "lyricalmyricalbooks@gmail.com";
    }
    match /authors/{authorId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "lyricalmyricalbooks@gmail.com";
    }
    match /shipping-profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "lyricalmyricalbooks@gmail.com";
    }
  }
}
