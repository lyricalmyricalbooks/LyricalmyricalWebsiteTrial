rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /digital-assets/{allPaths=**} {
      allow read: if false; // Only accessible via Admin SDK signed URLs on the backend
      allow write: if request.auth != null && request.auth.token.email == "lyricalmyricalbooks@gmail.com";
    }
  }
}
